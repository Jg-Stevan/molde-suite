// Prisma schema — Molde Studio (SQLite)
// Molde: plantilla universal v3 con sus zonas dibujadas.
// Prueba: corrida del motor sobre un documento real (resultados JSON).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Molde {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  documento   String?
  json        String
  imagenRef   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pruebas     Prueba[]
}

model Prueba {
  id               String   @id @default(cuid())
  molde            Molde    @relation(fields: [moldeId], references: [id], onDelete: Cascade)
  moldeId          String
  archivo          String
  // Archivo fuente persistido en el servidor (/uploads/...) para poder
  // RE-EJECUTAR la corrida contra una nueva versión del molde sin volver
  // a subir la foto/PDF ("Probar Plantilla" lo usa automáticamente).
  fuenteUrl        String?
  resultados       String
  score            Float?
  requiereRevision Boolean  @default(false)
  createdAt        DateTime @default(now())
  // Momento de la última re-ejecución (NO el de creación): la detección de
  // "corrida desactualizada" compara esto contra molde.updatedAt.
  updatedAt        DateTime @default(now()) @updatedAt
}
