// Prisma schema — Molde Studio (SQLite)
// Molde: plantilla universal v3 con sus zonas dibujadas.
// Prueba: corrida del motor sobre un documento real (resultados JSON).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Molde {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  documento   String?
  json        String
  imagenRef   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pruebas     Prueba[]
}

model Prueba {
  id               String   @id @default(cuid())
  molde            Molde    @relation(fields: [moldeId], references: [id], onDelete: Cascade)
  moldeId          String
  archivo          String
  // Archivo fuente persistido en el servidor (/uploads/...) para poder
  // RE-EJECUTAR la corrida contra una nueva versión del molde sin volver
  // a subir la foto/PDF ("Probar Plantilla" lo usa automáticamente).
  fuenteUrl        String?
  // D1 (informe de verificación §6.2, P0): documentos MULTI-PÁGINA subidos
  // como varias fotos. JSON array de URLs ordenadas por página — la
  // re-ejecución descarga TODAS y reconstruye el documento completo.
  // Antes solo se persistía la página 1 (subirFuente(ordenados[0])) y la
  // re-ejecución dejaba los campos de las páginas 2+ en `pagina_faltante`
  // con el score caído (33.3% con el molde E-14). `fuenteUrl` conserva la
  // página 1 como marcador de "es re-ejecutable" (compatibilidad).
  fuenteUrls       String?
  resultados       String
  score            Float?
  requiereRevision Boolean  @default(false)
  createdAt        DateTime @default(now())
  // Momento de la última re-ejecución (NO el de creación): la detección de
  // "corrida desactualizada" compara esto contra molde.updatedAt.
  updatedAt        DateTime @default(now()) @updatedAt
}
