# Cloudflare Pages — cabeceras del deploy estático (Bloque 2.7).
# COOP/COEP habilitan SharedArrayBuffer → WASM multihilo (onnxruntime-web +
# los workers IIFE de public/scanner). CSP universal: sin hub externo.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' data: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'

# Chunks de Next con hash de contenido → inmutables
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Modelos versionados (ppocr keys, ONNX por URL con sha256 en la app)
/models/*
  Cache-Control: public, max-age=86400

# Workers IIFE precompilados (fallback-canvas, reescalar-import, capa0-qr,
# db-postprocess) — cambian con release del core → revalidan a diario
/scanner/*
  Cache-Control: public, max-age=86400

# HTML y service worker siempre revalidados
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
