-    // histograma de PÍXELES, no de estos 9 valores).
-    vars.sort((a, b) => a - b);
-    const medianaVar = vars.length > 0 ? vars[Math.floor(vars.length / 2)] : 0;
-    const sharpnessHi = Math.min(100, Math.sqrt(Math.max(0, medianaVar)) * LAP_NORM);
