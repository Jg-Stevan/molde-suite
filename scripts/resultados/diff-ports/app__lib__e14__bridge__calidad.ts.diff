-    const total = w * h;
-    let acc = 0;
-    let p5 = 0;
-    let p95 = 255;
-    for (let b = 0; b < 256; b++) {
-      acc += hist[b];
-      if (acc >= total * 0.05) {
-        p5 = b;
-        break;
-      }
-    }
-    acc = 0;
-    for (let b = 0; b < 256; b++) {
-      acc += hist[b];
-      if (acc >= total * 0.95) {
-        p95 = b;
-        break;
-      }
