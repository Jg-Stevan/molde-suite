+/** Carga el catálogo Divipol (idempotente). Hoy: catálogo de demo incluido. */
+export async function cargarDivipol(): Promise<DivipolBase | null> {
+  if (cacheBase) return cacheBase;
+  cacheBase = BASE_DEMO;
+  estado = 'listo';
+  return cacheBase;
