# dependencias y builds
node_modules/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# entornos y logs
.env
.env.*
*.log
.DS_Store
*.pem

# datos locales y materiales de trabajo (no se publican)
# Modelos ONNX (stock, grandes) se sirven desde public/models en local; jamás al repo.
*.onnx
# Previews de investigación: capturas de actas reales (no se publican).
docs/investigacion/**/previews/
# FIX F2 (causa raíz — conversación de mejora): estos patrones deben estar
# ANCLADOS a la raíz (/upload/). El patrón suelto «upload/» matchea CUALQUIER
# directorio llamado upload a cualquier profundidad — incluido
# apps/molde-studio/src/app/api/upload/ — y por eso el handler de /api/upload
# JAMÁS llegó al repo: el commit 8dec868 lo escribió pero `git add` lo ignoró
# en silencio (documentado en el mensaje del commit, ausente del diff). Con el
# anclaje, el código de la ruta entra y los datos runtime siguen excluidos.
/upload/
/db/
*.db
/download/
/skills/
/public/actas/

# herramientas de agentes locales
.claude
.z-ai-config
.qoder/

# PIDs y archivos de runtime
*.pid

# uploads del servidor (documentos fuente)
# O1 (informe de verificación §6.3): anclado a la raíz por la misma causa
# raíz del FIX F2 — el patrón suelto «uploads/» matchearía CUALQUIER
# directorio llamado uploads a cualquier profundidad y podría volver a
# silenciar código futuro (la API vive en src/app/api/upload, sin s).
/uploads/

# Assets del motor de Tamiz MATERIALIZADOS por apps/tamiz/scripts (pesados, con
# URL+SHA-256 o md5 fijado). Rutas ancladas de punta a punta por la misma causa
# raíz del FIX F2: un patrón suelto como «vendor/» matchearía código a cualquier
# profundidad. Lo que SÍ va al repo es el worker precompilado (71 KB, md5 en
# packages/scanner-core/assets.lock.json) y el stub cargador opencv-4.5.5.js.
apps/tamiz/public/vendor/opencv-4.12.0-core.js
apps/tamiz/public/vendor/tesseract/
apps/tamiz/public/vendor/onnxruntime/
apps/tamiz/public/models/tess/
apps/tamiz/public/models/rapidocr/
# Los 4 IIFE se COMPILAN desde packages/scanner-core/workers/*.ts en `preparar`
# (scripts/construir-workers.mjs). heartbeat.worker.js es un artefacto huérfano:
# ningún código lo pide. detection-worker.js SÍ va al repo (no tiene fuente).
apps/tamiz/public/scanner/capa0-qr.worker.js
apps/tamiz/public/scanner/db-postprocess.worker.js
apps/tamiz/public/scanner/fallback-canvas.worker.js
apps/tamiz/public/scanner/reescalar-import.worker.js
apps/tamiz/public/scanner/heartbeat.worker.js

# Scratch local de verificación (volcados de BD, capturas)
_verificacion/
# Salidas de procesos lanzados en segundo plano durante la verificación
*.out
*.err

# Fixtures servidos al teléfono durante el banco E2E (los originales viven en
# scripts/resultados/fixtures/; se copian aquí solo para que el dev server los
# sirva a Chrome Android, que no puede leer /sdcard vía CDP).
# REGLA DE PRIVACIDAD (plan de cierre §3.3 y §9-1): el repo es PÚBLICO —
# NADA de fotos de documentos reales se versiona, ni aquí ni en
# scripts/resultados/. Las fotos del banco viven SOLO en local; subirán
# únicamente si el dueño confirma que son sintéticas/anonimizadas.
apps/tamiz/public/dev-fixtures/
scripts/resultados/

# V6 (plan PLAN-AGENTE-V6-PRIVACIDAD-Y-PRUEBA-REC-A-2026-11-26, decisión §9-1):
# el repo es PÚBLICO — ningún material derivado de documentos reales se
# versiona. scripts/resultados/ ya estaba ignorado como directorio; lo que
# sigue son los patrones que FALTABAN para material fuera de él. Todos van
# anclados o con nombre explícito (lección FIX F2: un patrón suelto silencia
# código futuro en silencio).
# Banco local de la prueba REC-A y de arneses de fotos reales (raíz del repo):
/dev-fixtures/
# Informe de calibración GENERADO por herramientas/verificar_calibracion.py a
# partir de documentos reales (contiene lecturas con datos personales):
/herramientas/informe-calibracion.json
# Arnoses de entrega que solo existen para servir/procesar FOTOS REALES del
# operador (las fotos viven en /dev-fixtures/ o /upload/, nunca en el repo).
# Se retiran del índice y quedan SOLO en disco local:
/scripts/entrega/experimento-encode.mjs
/scripts/entrega/experimento-encode-bw.mjs
/scripts/entrega/experimento-webp.mjs
/scripts/entrega/mostrar-app-a56.mjs
/scripts/entrega/mostrar-bw-a56.mjs
/scripts/entrega/mostrar-webp-app.mjs
/scripts/entrega/perfilar-cpu-worker.mjs
/scripts/entrega/verificar-moldes-reales-a56.mjs
/scripts/entrega/verificar-perfil-reales.mjs
/scripts/entrega/verificar-procesado-reales.mjs
/scripts/entrega/verificar-reales.mjs
/scripts/entrega/verificar-recorte-reales.mjs
