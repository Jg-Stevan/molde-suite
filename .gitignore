# dependencias y builds
node_modules/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# entornos y logs
.env
.env.*
*.log
.DS_Store
*.pem

# datos locales y materiales de trabajo (no se publican)
# Modelos ONNX (stock, grandes) se sirven desde public/models en local; jamás al repo.
*.onnx
# Previews de investigación: capturas de actas reales (no se publican).
docs/investigacion/**/previews/
# FIX F2 (causa raíz — conversación de mejora): estos patrones deben estar
# ANCLADOS a la raíz (/upload/). El patrón suelto «upload/» matchea CUALQUIER
# directorio llamado upload a cualquier profundidad — incluido
# apps/molde-studio/src/app/api/upload/ — y por eso el handler de /api/upload
# JAMÁS llegó al repo: el commit 8dec868 lo escribió pero `git add` lo ignoró
# en silencio (documentado en el mensaje del commit, ausente del diff). Con el
# anclaje, el código de la ruta entra y los datos runtime siguen excluidos.
/upload/
/db/
*.db
/download/
/skills/
/public/actas/

# herramientas de agentes locales
.claude
.z-ai-config

# PIDs y archivos de runtime
*.pid

# uploads del servidor (documentos fuente)
# O1 (informe de verificación §6.3): anclado a la raíz por la misma causa
# raíz del FIX F2 — el patrón suelto «uploads/» matchearía CUALQUIER
# directorio llamado uploads a cualquier profundidad y podría volver a
# silenciar código futuro (la API vive en src/app/api/upload, sin s).
/uploads/

# Assets del motor de Tamiz MATERIALIZADOS por apps/tamiz/scripts (pesados, con
# URL+SHA-256 o md5 fijado). Rutas ancladas de punta a punta por la misma causa
# raíz del FIX F2: un patrón suelto como «vendor/» matchearía código a cualquier
# profundidad. Lo que SÍ va al repo es el worker precompilado (71 KB, md5 en
# packages/scanner-core/assets.lock.json) y el stub cargador opencv-4.5.5.js.
apps/tamiz/public/vendor/opencv-4.12.0-core.js
apps/tamiz/public/vendor/tesseract/
apps/tamiz/public/vendor/onnxruntime/
apps/tamiz/public/models/tess/
apps/tamiz/public/models/rapidocr/
# Los 4 IIFE se COMPILAN desde packages/scanner-core/workers/*.ts en `preparar`
# (scripts/construir-workers.mjs). heartbeat.worker.js es un artefacto huérfano:
# ningún código lo pide. detection-worker.js SÍ va al repo (no tiene fuente).
apps/tamiz/public/scanner/capa0-qr.worker.js
apps/tamiz/public/scanner/db-postprocess.worker.js
apps/tamiz/public/scanner/fallback-canvas.worker.js
apps/tamiz/public/scanner/reescalar-import.worker.js
apps/tamiz/public/scanner/heartbeat.worker.js
